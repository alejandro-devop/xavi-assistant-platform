# Copy to infra/.env and fill in. The real .env is gitignored — never commit it.

# Public hostname the n8n editor is served on through the Cloudflare Tunnel.
N8N_HOST=n8n.example.com

# Timezone n8n uses for cron-style triggers.
GENERIC_TIMEZONE=America/Bogota

# Cloudflare Tunnel token (Zero Trust -> Networks -> Tunnels -> create ->
# copy the token). Only needed with: docker compose --profile tunnel up -d
TUNNEL_TOKEN=
