# Gateway environment. Copy to `.env` (gitignored) and fill in real values.
# The server loads it via `node --env-file=.env` (see the `start` script).

# Static bearer token required on every route except GET /healthz.
# Generate a real value with: openssl rand -hex 32
GATEWAY_BEARER_TOKEN=replace-with-output-of-openssl-rand-hex-32

# Ollama server used for intent detection. Both optional; defaults shown.
# From this host the native Ollama answers on localhost:11434.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# n8n webhook base for skill dispatch. Optional; default shown.
# Xavi's n8n listens on 5679 (NOT 5678 — that port belongs to another stack).
N8N_WEBHOOK_BASE=http://localhost:5679/webhook
